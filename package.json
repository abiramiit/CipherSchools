{
    "name": "designforge-root",
    "version": "1.0.0",
    "description": "DesignForge Complete Application",
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && npm run start",
        "dev:frontend": "cd web && npm run dev",
        "install:all": "npm install && cd backend && npm install && cd ../web && npm install",
        "db:setup": "cd backend && npx prisma db push && npm run seed"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}